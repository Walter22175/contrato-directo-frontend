# Sentry (requerido en Vercel: Production y Preview)
# NEXT_PUBLIC_SENTRY_DSN se inlinea en el bundle del cliente durante el build:
# si falta, Sentry no se inicializa en el navegador. Usá el mismo DSN en ambas
# variables y hacé un redeploy después de cambiarlas.
#
# Interruptor general: con NEXT_PUBLIC_SENTRY_ENABLED=false el SDK queda en
# reposo (no inicializa, no captura y no envía nada) aunque el DSN siga
# configurado. Para reactivarlo, ponelo en true y hacé un redeploy.
NEXT_PUBLIC_SENTRY_ENABLED=true
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Vercel define automáticamente NEXT_PUBLIC_VERCEL_ENV y
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA (cliente), y VERCEL_ENV /
# VERCEL_GIT_COMMIT_SHA (servidor). Solo definí estas si querés sobreescribirlas.
NEXT_PUBLIC_VERCEL_ENV=development
VERCEL_ENV=development
NEXT_PUBLIC_COMMIT_SHA=
COMMIT_SHA=

# Muestreo de trazas (0.0 a 1.0). En edge el valor por defecto es 0.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.1
